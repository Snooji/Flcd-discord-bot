# --- Discord delivery (set ONE of the two options) ---

# Option A (simplest): a channel webhook.
# Channel settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# Option B: a bot user. Create at https://discord.com/developers/applications,
# invite it with "Send Messages" + "Attach Files", then paste the token and
# the target channel's ID (enable Developer Mode in Discord, right-click channel -> Copy ID).
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# --- Watcher settings (all optional) ---

# Page to watch
DEALS_URL=https://flcannabisdeals.org/todays-florida-dispensary-deals/

# How often to check, in minutes
POLL_INTERVAL_MINUTES=15

# Where the "already posted" record is kept
STATE_FILE=./data/state.json

# Only look at images inside the first of these CSS selectors that contains images.
# Comma-separated, tried in order. Leave blank to use the built-in list.
CONTENT_SELECTOR=

# Ignore images whose URL or alt text matches this regex (case-insensitive)
EXCLUDE_PATTERN=logo|icon|avatar|emoji|gravatar|favicon|spinner|placeholder|badge|button|wp-includes|/plugins/|/themes/

# Ignore images smaller than this many bytes (filters icons / tracking pixels)
MIN_IMAGE_BYTES=15000

# On the very first run, post everything currently on the page (true) or
# just remember it silently and only post future changes (false)
POST_ON_FIRST_RUN=true

# Log level: debug | info | warn | error
LOG_LEVEL=info
